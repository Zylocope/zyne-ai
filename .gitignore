# ── dependencies ──────────────────────────────────────────────
node_modules/

# ── build output ──────────────────────────────────────────────
releases/
dist/
target/

# ── Tauri generated mobile project ────────────────────────────
# Regenerate with `pnpm tauri android init`. Also holds the release
# keystore, so it must never be committed.
zyne-app/src-tauri/gen/

# ── signing secrets ───────────────────────────────────────────
# Belt and braces, in case gen/ is ever un-ignored.
*.keystore
*.jks
keystore.properties
apikey.txt

# ── local data ────────────────────────────────────────────────
*.db
*.db-journal
*.apk

# ── editor / tooling / OS ─────────────────────────────────────
.idea/
.vscode/
# ignore .claude contents (any folder) but keep shared slash commands
**/.claude/*
!**/.claude/commands/
.DS_Store
Thumbs.db

# ── tarot masters ─────────────────────────────────────────────
# Logo/*.jpg holds the 2048px card originals, ~51MB against a 6.8MB repo.
# Git keeps blobs forever, so these stay out; the 1024px copies the app
# actually loads are committed under zyne-app/src/assets/tarot/.
# Back the masters up somewhere off this laptop — they cannot be regenerated.
Logo/*.jpg
